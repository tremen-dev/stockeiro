# =============================================================================
# Stockeiro — plantilla de variables de entorno (SIN secretos)
# -----------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores reales. .env está en
# .gitignore y NO se commitea. En producción (Vercel), define estas claves en
# Settings → Environment Variables del proyecto, no en un fichero.
# =============================================================================

# Neon Postgres (ADR-001). En producción, la connection string del proyecto Neon.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Driver de DB, intercambiable (src/db/client.ts):
#   neon (por defecto) → Neon serverless (producción / Neon).
#   pg                 → Postgres estándar local, sin SSL (dev / e2e efímero).
# DB_DRIVER="pg"

# Auth.js / NextAuth (ADR-001). Genera con: npx auth secret (o openssl rand -base64 32)
AUTH_SECRET="change-me"

# Necesaria cuando la app corre tras un proxy (Vercel, e2e).
AUTH_TRUST_HOST="true"

# Twelve Data (ADR-002/ADR-007) — SOLO búsqueda de símbolos por nombre (SPEC-008).
# Su free tier NO cubre BME/M.CONTINUO, así que ya NO se usa para cotizaciones
# (ADR-012); su /symbol_search sí funciona en free y se mantiene. Tests: proveedor fake.
TWELVE_DATA_API_KEY=""

# Marketstack (ADR-012) — COTIZACIONES (SPEC-015). Sustituye a Twelve Data como
# proveedor de precios porque SÍ cubre BME/M.CONTINUO, el mercado principal del usuario
# (~82% de la cartera). Free tier: 100 req/mes (consumo real ~30: 1 batch/día) y sirve
# BMEX. OJO: el free NO concede derechos de uso comercial — riesgo asumido (R-F1 de
# EPIC-FIX); pasar al plan Basic ($9.99/mes) es cambiar de plan, misma key, cero código.
# El adaptador real la usa; los tests usan un fake y no llaman a la API.
MARKETSTACK_API_KEY=""

# Secreto que protege el endpoint de refresco /api/cron/refresh (ADR-004, SPEC-004).
# Genera uno propio (openssl rand -hex 32). Vercel Cron lo envía como
# Authorization: Bearer <CRON_SECRET>; sin él, la ruta rechaza la petición.
CRON_SECRET="change-me"

# Aviso proactivo por email — Resend (ADR-006, SPEC-006). El adaptador real
# (ResendSender) la usa; los tests usan un sender fake y no llaman a la API.
# Requiere además un dominio verificado en Resend para el remitente.
RESEND_API_KEY=""
# Remitente de los avisos (debe pertenecer a un dominio verificado en Resend).
RESEND_FROM="Stockeiro <avisos@stockeiro.app>"
