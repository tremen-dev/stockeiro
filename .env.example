# Neon Postgres (ADR-001). En producción, la connection string del proyecto Neon.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js / NextAuth (ADR-001). Genera con: npx auth secret
AUTH_SECRET="change-me"

