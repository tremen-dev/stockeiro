# =============================================================================
# Stockeiro — plantilla de variables de entorno (SIN secretos)
# -----------------------------------------------------------------------------
# Copia este fichero a .env y rellena los valores reales. .env está en
# .gitignore y NO se commitea. En producción (Vercel), define estas claves en
# Settings → Environment Variables del proyecto, no en un fichero.
# =============================================================================

# Neon Postgres (ADR-001). En producción, la connection string del proyecto Neon.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Driver de DB, intercambiable (src/db/client.ts):
#   neon (por defecto) → Neon serverless (producción / Neon).
#   pg                 → Postgres estándar local, sin SSL (dev / e2e efímero).
# DB_DRIVER="pg"

# Auth.js / NextAuth (ADR-001). Genera con: npx auth secret (o openssl rand -base64 32)
AUTH_SECRET="change-me"

# Necesaria cuando la app corre tras un proxy (Vercel, e2e).
AUTH_TRUST_HOST="true"

# Origen absoluto de la app (SPEC-023, ADR-015 pto. 8). De aquí —y NUNCA de la
# cabecera Host / X-Forwarded-Host de la petición— sale el enlace de recuperación de
# contraseña que viaja por correo. Con AUTH_TRUST_HOST=true, componerlo desde la
# cabecera permitiría a un atacante pedir el reset de una cuenta ajena con un Host
# falsificado y lograr que NUESTRO correo llevase a la víctima a su servidor.
# Sin dominio ni barra final. Si falta o apunta mal, los enlaces no funcionan en
# absoluto (F-SPEC-023-3). Ejemplo local: http://localhost:3000
APP_BASE_URL="https://stockeiro.app"

# Twelve Data (ADR-002/ADR-007) — SOLO búsqueda de símbolos por nombre (SPEC-008).
# Su free tier NO cubre BME/M.CONTINUO, así que ya NO se usa para cotizaciones
# (ADR-012); su /symbol_search sí funciona en free y se mantiene. Tests: proveedor fake.
TWELVE_DATA_API_KEY=""

# Marketstack (ADR-012) — COTIZACIONES (SPEC-015). Sustituye a Twelve Data como
# proveedor de precios porque SÍ cubre BME/M.CONTINUO, el mercado principal del usuario
# (~82% de la cartera).
# PLAN: Basic, 10.000 unidades/mes, cuenta propia, desde el 2026-08-23 (ADR-032).
# Se factura por SÍMBOLO, no por llamada: una petición con 13 tickers gasta 13 unidades
# (ADR-027 pto. 1). Consumo real ~400/mes (13 símbolos × ~31 ciclos) → holgura ~25×, y
# el techo con ciclo diario está en ~322 símbolos distintos. Creer que se cobra por
# llamada es el error que dejó tres días de precios congelados en agosto de 2026.
# El adaptador real la usa; los tests usan un fake y no llaman a la API.
MARKETSTACK_API_KEY=""

# Secreto que protege el endpoint de refresco /api/cron/refresh (ADR-004, SPEC-004).
# Genera uno propio (openssl rand -hex 32). Vercel Cron lo envía como
# Authorization: Bearer <CRON_SECRET>; sin él, la ruta rechaza la petición.
CRON_SECRET="change-me"

# Aviso proactivo por email — Resend (ADR-006, SPEC-006). El adaptador real
# (ResendSender) la usa; los tests usan un sender fake y no llaman a la API.
# Requiere además un dominio verificado en Resend para el remitente.
RESEND_API_KEY=""
# Remitente de los avisos (debe pertenecer a un dominio verificado en Resend).
RESEND_FROM='"Stockeiro - tremen.dev" <stockeiro@tremen.dev>'

# Canal de feedback (SPEC-039, CE-8). La dirección a la que escribe el tester desde
# el enlace del pie. Es la ÚNICA variable de entorno que añade EPIC-004.
#
# Por defecto —y es lo esperado en producción— NO hace falta definirla: si falta, o
# si llega vacía, se usa el contacto del titular del aviso legal (`hola@tremen.dev`,
# src/lib/legal/content.ts). Un solo dato para las dos cosas, escrito en un solo
# sitio: que no se dupliquen es parte de CA-16, porque dos literales acaban siendo
# dos direcciones distintas publicadas y una de ellas muerta.
#
# Existe para poder reapuntar el canal a otro buzón sin desplegar código. Se valida
# por CONTENIDO, no por presencia: una cadena que no parece un correo se ignora y se
# cae al contacto del titular, en vez de componer un `mailto:` a la nada.
# FEEDBACK_EMAIL="hola@tremen.dev"
